# Application (copier ce fichier vers .env.local puis renseigner les valeurs)
# Ne jamais commiter .env.local ni une clé secrète.
NEXT_PUBLIC_SITE_URL=https://joie-de-vivr.netlify.app
# URL utilisée dans les liens envoyés par les Edge Functions Supabase (secret/configuration Edge).
SITE_URL=https://joie-de-vivr.netlify.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paiements FedaPay (serveur uniquement sauf identifiant public si ajouté ultérieurement)
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
# Liste séparée par des virgules d'IP autorisées pour le webhook, si utilisée par la configuration.
FEDAPAY_IP_WHITELIST=

# IA côté serveur (route JDV CRM)
OPENAI_API_KEY=
OPENAI_MODEL=
# IA de vérification des dossiers dans Supabase Edge Function company-ai-review.
# Facultatif : sans cette clé, le contrôle automatique limité et la revue humaine restent utilisés.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Envoi d'e-mails par Supabase Edge Functions (secrets Edge, pas nécessaires dans le navigateur).
# Définir également SITE_URL=https://joie-de-vivr.netlify.app dans les secrets Edge.
RESEND_API_KEY=
EMAIL_FROM=JDV CRM <onboarding@resend.dev>

# Analytics et liens de contact (facultatifs)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PHONE_PREFIX=229
